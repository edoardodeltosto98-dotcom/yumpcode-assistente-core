# Copia questo file in .env.local e riempi i valori.
# .env.local NON va mai committato (e' in .gitignore).
#
# Regola di Fase 3: qui vanno SOLO le chiavi di servizio (di YUMPCODE).
# I token OAuth dei singoli clienti non vanno mai qui: sono dati
# dinamici, uno per cliente, e vivono cifrati nel database
# (vedi src/common/crypto/encryption.service.ts).

PORT=3001

# Chiave a 32 byte in base64 usata per cifrare/decifrare i token OAuth
# dei clienti nel database (AES-256-GCM). Generala con:
#   npm run keygen
# In produzione va salvata nel gestore segreti dell'hosting
# (es. Vercel/Supabase secrets), non in un file sul server.
ENCRYPTION_KEY=

# Database Supabase (Fase 4). Usa la connessione "Session pooler"
# (IPv4, gratuita) dal progetto Supabase, non "Direct connection"
# (richiede un add-on a pagamento).
DATABASE_URL=

# Redis in locale, via Docker (Fase 4, docker-compose.yml).
REDIS_URL=redis://localhost:6379
# Facoltativo: quanti job al minuto puo' accodare un singolo cliente (default 60).
# QUOTA_AZIONI_PER_MINUTO=60

# OAuth Google (Fase 5). Da Google Cloud Console > Google Auth Platform
# > Client > (client di tipo "Applicazione web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve combaciare esattamente con l'URI di reindirizzamento autorizzato
# impostato sul client Google.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Webhook Clerk (sincronizza le organizzazioni con la tabella clienti,
# src/webhooks). Da Clerk dashboard > Webhooks > crea endpoint puntato a
# <url-backend>/webhooks/clerk, eventi "organizationMembership.created"
# e "organization.deleted" > "Signing Secret".
CLERK_WEBHOOK_SECRET=

# Login Clerk sul backend (src/common/auth). Ogni endpoint, tranne quelli
# marcati @Pubblico(), richiede "Authorization: Bearer <token di sessione
# Clerk>" con un'organizzazione attiva. Non e' un segreto: e' il dominio
# dell'istanza Clerk (Clerk dashboard > Configure > Domains > Frontend API).
CLERK_ISSUER=https://alive-owl-9191.clerk.accounts.dev
# Siti da cui accettiamo token (claim "azp") e richieste dal browser
# (CORS). Separati da virgola. In produzione: l'URL reale del cruscotto.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Facoltativa: indirizzo del cruscotto a cui tornare dopo il collegamento Google.
# Se manca si usa la prima origine di CORS_ORIGINS.
# CRUSCOTTO_URL=http://localhost:3000
# Opzionale: URL pubblico del backend, usato per costruire il link di
# collegamento Google. Se vuoto si usa l'host della richiesta.
# BACKEND_PUBLIC_URL=http://localhost:3001

# Verra' aggiunta in una fase successiva (richiede un account a
# pagamento, quindi non ancora configurata):
# ANTHROPIC_API_KEY=
